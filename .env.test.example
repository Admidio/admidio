# Admidio Regression Test Suite - Environment Configuration
# Copy this file to .env.test and update values for your environment
#
# A variable that is already set in the process environment wins over this file, so a CI job
# configures a run through its own environment and needs no .env.test at all.

# Test Database Configuration
# Supported engines: mariadb, mysql, postgres

# Primary test database (runs on every PR)
TEST_DATABASE_ENGINE=mariadb

# MariaDB/MySQL connection
# Use 127.0.0.1 rather than localhost: a MySQL client reads localhost as "connect through the
# unix socket", which does not reach a database published on a port by Docker.
TEST_DB_MARIADB_HOST=127.0.0.1
TEST_DB_MARIADB_PORT=3306
TEST_DB_MARIADB_USER=admidio
TEST_DB_MARIADB_PASS=admidio_test
TEST_DB_MARIADB_NAME=admidio_test

# PostgreSQL connection (optional, for cross-database testing)
TEST_DB_POSTGRES_HOST=127.0.0.1
TEST_DB_POSTGRES_PORT=5432
TEST_DB_POSTGRES_USER=admidio
TEST_DB_POSTGRES_PASS=admidio_test
TEST_DB_POSTGRES_NAME=admidio_test

# MySQL 8.0 connection (optional, scheduled tests only)
TEST_DB_MYSQL_HOST=127.0.0.1
TEST_DB_MYSQL_PORT=3306
TEST_DB_MYSQL_USER=admidio
TEST_DB_MYSQL_PASS=admidio_test
TEST_DB_MYSQL_NAME=admidio_test

# Mail Testing (Mailpit)
# No test sends mail at the moment, the setup script only reports whether the server is reachable.
TEST_MAIL_HOST=127.0.0.1
TEST_MAIL_PORT=1025
TEST_MAIL_USER=
TEST_MAIL_PASS=

# Test Files
# The adm_my_files of the test run: Admidio's FOLDER_DATA is set to this directory, so nothing
# a test writes ends up in the adm_my_files of the checkout. It has to be inside the checkout
# and its path has to contain "test" (safety measure).
TEST_FILES_PATH=./tests/adm_my_files

# Setup Instructions for Local Development:
#
# 1. Copy this file:
#    cp .env.test.example .env.test
#
# 2. Start Docker services:
#    docker-compose -f docker-compose.test.yml up -d
#
# 3. Wait for databases to be ready (~30 seconds)
#
# 4. Run setup script:
#    php tests/bin/setup-test-env.php
#
# 5. Run tests:
#    composer test:unit
#    composer test:integration
#    composer test:cli
#
# 6. Stop services when done:
#    docker-compose -f docker-compose.test.yml down
#
# To run the suite against another engine, set TEST_DATABASE_ENGINE above (or in the environment)
# and run the setup script again. The engine is not a command line option of the test run.
#
# GitHub Actions sets these variables in the workflow itself, so the runner needs no .env.test.
