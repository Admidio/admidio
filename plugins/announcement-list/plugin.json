    "url": "https://www.admidio.org",
    "icon": "bi-newspaper",
    "requires": {
        "admidio": ">=5.1",
        "php": ">=8.2"
    },
    "autoload": {
        "AdmidioPlugin\\AnnouncementList\\": "src/"
    },
    "preferences": {
        "section": "overview_extensions"
    },
    "settings": {
        "announcement_list_plugin_enabled": {
            "type": "enum",
            "default": "1",
            "values": ["0", "1", "2"],
            "label": "ORG_ACCESS_TO_PLUGIN",
            "description": "ORG_ACCESS_TO_PLUGIN_DESC"
        },
        "announcement_list_overview_sequence": {
            "type": "integer",
            "default": 6
        },
        "announcement_list_announcements_count": {
            "type": "integer",
            "default": 2,
            "label": "PLG_ANNOUNCEMENT_LIST_PREFERENCES_ANNOUNCEMENTS_COUNT",
            "description": "PLG_ANNOUNCEMENT_LIST_PREFERENCES_ANNOUNCEMENTS_COUNT_DESC"
