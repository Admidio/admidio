<resources>
  <string name="PLG_WHO_IS_ONLINE_HEADLINE">இணையத்தில் யார் உள்ளனர்?</string>
  <string name="PLG_WHO_IS_ONLINE_NO_DATA_VISITORS">பார்வையாளர்களுக்குத் தகவல்கள் கிடைக்காது. இணையத்தில் யார் உள்ளனர் என்பதைக் காண உள்நுழையவும்.</string>
  <string name="PLG_WHO_IS_ONLINE_NO_VISITORS_ON_WEBSITE">இணையதளத்தில் பார்வையாளர்கள் யாரும் இல்லை.</string>
